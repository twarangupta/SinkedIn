// SinkedIn — Prisma schema (source of truth for all data shapes).
//
// Phase 0/1 scope only. Models reproduced from the technical spec
// (docs/SinkedIn_Tech_Spec_Phase0_1.md) — the exact source of truth.
// More tables are added in later phases; do not build ahead of the spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection used by the app at runtime (e.g. Supabase's
  // PgBouncer pooler). For local development this points at the local
  // Postgres. This is what serves normal queries.
  url = env("DATABASE_URL")

  // Direct (non-pooled) connection used by Prisma Migrate for schema
  // changes, which need a real session the pooler can't provide. For local
  // development set this to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id             String     @id @default(uuid())
  supabaseUserId String     @unique // Supabase Auth user id, never exposed publicly
  handle         String     @unique // e.g. "Rejected_Raccoon_402" — public-facing
  avatarId       String     @default("pufferfish") // ocean-creature avatar id (see lib/avatars.ts); public, no PII. Set deterministically from handle on signup, user-changeable.
  handleChosen   Boolean    @default(false) // false until the user picks/keeps a handle in the first-run onboarding
  createdAt      DateTime   @default(now())
  sinks          Sink[]
  votes          Vote[]
  comments       Comment[]
  commentVotes   CommentVote[]
  pollVotes      PollVote[]
  reports        Report[]
  bookmarks      Bookmark[]
  applications   Application[]
  reactions      Reaction[]
  notifications      Notification[] @relation("NotificationRecipient") // received
  actedNotifications Notification[] @relation("NotificationActor") // triggered by this user
}

// One-tap solidarity reaction (Rant → "Been there", Ghosted → "Same"), separate
// from Buoy/Anchor voting. One reaction per user per Sink; `kind` must be one of
// the Sink's category's configured reaction keys (enforced in the service).
model Reaction {
  id        String   @id @default(uuid())
  sinkId    String
  sink      Sink     @relation(fields: [sinkId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String
  createdAt DateTime @default(now())

  @@unique([sinkId, userId]) // one reaction per user per Sink
  @@index([sinkId])
}

// A Sink is a Reddit-style post: always a title + body, categorized by a category.
// Depending on the category, the compose form reveals a few optional extra fields
// (company, conclusion, poll options). Those fields are shared/optional on the
// Sink itself — NOT separate per-category tables — so the model stays simple.
model Sink {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  title      String // every Sink has a title
  body       String?  @db.Text // the main text (optional for e.g. pure Poll)
  imageUrl   String? // optional attached image (a plain URL; storage provider is swappable)

  // --- optional category-conditional fields (nullable; only some categories use them) ---
  company         String? // free-text label (Interview Experience, Rejection, Ghosted, etc.)
  companyId       String? // resolved centralized Company (logos + Phase-3 company pages)
  companyRef      Company? @relation(fields: [companyId], references: [id])
  conclusion      Conclusion? // shown for Interview Experience / Offer etc.
  conclusionOther String? // free text, used only when conclusion = OTHER
  // poll options live in the PollOption table below (one-to-many)

  score      Int       @default(0) // cached buoy score for ranking (buoys - anchors)
  isVerified Boolean   @default(false) // Phase 4 — always false in Phase 1
  deletedAt  DateTime? // soft delete, never hard-delete
  createdAt  DateTime  @default(now())

  // Highest milestone the owner has already been notified about, so buoy/poll
  // notifications fire once per milestone (not per vote) and never on oscillation.
  notifiedBuoyMilestone Int @default(0)
  notifiedPollMilestone Int @default(0)

  // Cached per-kind reaction tallies, e.g. { "BEEN_THERE": 5, "IKR": 2 } — kept
  // fresh in the reaction service (like `score`) so the feed reads counts
  // without a groupBy per card. The per-user Reaction rows below are the truth.
  reactionCounts Json      @default("{}")
  reactions      Reaction[]

  votes       Vote[]
  comments    Comment[]
  pollOptions PollOption[]
  bookmarks   Bookmark[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([score])
  @@index([companyId])
}

// Categories are their own table so new ones can be added with NO code/schema change.
// The `config` fields describe which optional inputs the compose form reveals.
model Category {
  id              String  @id @default(uuid())
  name            String  @unique // "Interview Experience", "Discussion", "Poll", ...
  slug            String  @unique // "interview-experience"
  color           String // hex or token for the category pill
  description     String? // one-line hint shown in the compose "what's this?" modal
  showsCompany    Boolean @default(false)
  showsConclusion Boolean @default(false)
  allowsPoll      Boolean @default(false) // optional poll (Discussion, Advice)
  requiresPoll    Boolean @default(false) // poll mandatory (Poll category)
  // One-tap solidarity reactions this category offers, as opaque presentational
  // config: [{ "key": "BEEN_THERE", "emoji": "🫡", "label": "Been there" }].
  // JSON (not a table) because it's small, variable, and never queried by field
  // — adding/altering a category's reactions stays a pure data change.
  reactions       Json?
  sinks           Sink[]
}

enum Conclusion {
  GHOSTED
  REJECTED
  ACCEPTED
  WITHDREW
  PENDING
  OTHER // when picked, the free-text conclusionOther field is used
}

// --- Voting: "Buoys" (up) and "Anchors" (down) — our themed two-way vote. ---
// Buoy lifts a Sink toward the surface; anchor sinks it. score = buoys - anchors.
enum VoteValue {
  BUOY // +1, up arrow, lift it up
  ANCHOR // -1, down arrow, sink it
}

model Vote {
  id        String    @id @default(uuid())
  sinkId    String
  sink      Sink      @relation(fields: [sinkId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  value     VoteValue
  createdAt DateTime  @default(now())

  @@unique([sinkId, userId]) // one vote per user per Sink
}

// --- Polls (Phase 1): a Sink can carry options; users vote on one. ---
model PollOption {
  id       String     @id @default(uuid())
  sinkId   String
  sink     Sink       @relation(fields: [sinkId], references: [id])
  label    String
  position Int // display order
  votes    PollVote[]
}

model PollVote {
  id           String     @id @default(uuid())
  pollOptionId String
  option       PollOption @relation(fields: [pollOptionId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
  // NOTE: enforce "one vote per poll (not per option)" in the service layer.

  @@unique([pollOptionId, userId])
}

// --- Moderation (Phase 1): users report; hiding is a manual soft-delete for
// now (the full review console is Phase 3). targetType + targetId is a light
// polymorphic pointer at a Sink or Comment (no FK — reports outlive targets). ---
enum ReportTargetType {
  SINK
  COMMENT
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id         String           @id @default(uuid())
  targetType ReportTargetType
  targetId   String
  reason     String? // optional free-text detail from the reporter
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id])
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())

  @@unique([targetType, targetId, reporterId]) // one report per user per target
  @@index([status])
  @@index([targetType, targetId])
}

// --- Comments (Phase 1): Reddit needs them. Threaded via optional parentId. ---
model Comment {
  id        String    @id @default(uuid())
  sinkId    String
  sink      Sink      @relation(fields: [sinkId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  body      String    @db.Text
  parentId  String? // null = top-level; set = reply (threading)
  parent    Comment?  @relation("Thread", fields: [parentId], references: [id])
  replies   Comment[] @relation("Thread")
  score     Int       @default(0) // cached buoy score (buoys - anchors), for ranking the top comment
  votes     CommentVote[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([sinkId])
  @@index([score])
}

// --- Bookmarks (Phase 1): a user privately saves a Sink to read later.
// Owner-only; never affects the Sink's public score. ---
model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  sinkId    String
  sink      Sink     @relation(fields: [sinkId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, sinkId]) // one bookmark per user per Sink
  @@index([userId])
}

// Buoy/Anchor voting on a Comment — a direct mirror of Vote (on Sinks).
// One vote per user per Comment; score cached on the Comment (buoys - anchors).
model CommentVote {
  id        String    @id @default(uuid())
  commentId String
  comment   Comment   @relation(fields: [commentId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  value     VoteValue
  createdAt DateTime  @default(now())

  @@unique([commentId, userId]) // one vote per user per Comment
}

// --- Phase 2: private personal job tracker. Owner-only, real PII (real company
// names, dates, notes). NEVER exposed in any public/pseudonymous response, never
// indexed. The pseudonymity wall: tracker data does not leak to the public side;
// the only bridge is a user-initiated "post a Sink from this" (built later). ---
enum ApplicationStatus {
  SAVED
  APPLIED
  OA // online assessment
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
  WITHDRAWN
  OTHER // free-text label in statusOther
}

model Application {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  company     String // free-text label (kept for display + as a fallback)
  companyId   String? // resolved centralized Company (Phase 2 audit: capture-now)
  companyRef  Company? @relation(fields: [companyId], references: [id])
  role        String
  status      ApplicationStatus @default(SAVED)
  statusOther String? // used only when status = OTHER
  jobUrl      String? // link to the original external posting
  appliedAt   DateTime? // when the user applied (null while still SAVED)
  notes       String?           @db.Text
  // Private resume PDF for this application. Stores the Supabase Storage object
  // key in the PRIVATE `resumes` bucket (path `{supabaseUserId}/{uuid}.pdf`), not
  // a public URL: the file is PII, read only via short-lived signed URLs. One
  // resume per application; null when none. Never exposed outside the owner.
  resumeFileKey String?
  // Original filename of the uploaded resume (e.g. "Ada_Lovelace_CV.pdf"), for
  // display only. Set/cleared together with resumeFileKey.
  resumeFileName String?
  deletedAt   DateTime? // soft delete (never hard-delete in normal operation)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  events      ApplicationEvent[]
  rounds      InterviewRound[]

  @@index([userId, status])
  @@index([companyId])
}

// Centralized company entity (Phase 2 audit: capture-now). Neutral identity
// (names only, no PII) so Jobs, Sinks, interviews, and salary reports can later
// share one company and power aggregated insights. Deduped by normalizedName.
model Company {
  id             String        @id @default(uuid())
  name           String // display name as first entered
  normalizedName String        @unique // lowercased/trimmed key: dedupe + autocomplete
  domain         String? // optional canonical domain, e.g. "razorpay.com"
  createdById    String? // user id who first added it (no FK — outlives users)
  verified       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  applications   Application[]
  sinks          Sink[]
}

// Status history for the tracker (Phase 2 audit: capture-now). One row per
// status transition, plus the initial status on create, so personal analytics
// (response time, ghosting duration, interview/offer rate) stay reconstructable.
model ApplicationEvent {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id])
  status        ApplicationStatus
  note          String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt])
}

// Interview rounds are OPTIONAL and per-application (Phase 2 audit): a company
// may have zero or many, in any shape. Users add / remove / reorder them, so the
// count varies per company. Private (owner-only via the parent Application).
enum InterviewRoundType {
  PHONE_SCREEN
  ONLINE_ASSESSMENT
  TECHNICAL
  SYSTEM_DESIGN
  BEHAVIORAL
  HIRING_MANAGER
  HR
  OTHER // free-text label in typeOther
}

enum InterviewRoundResult {
  PENDING
  CLEARED
  REJECTED
}

model InterviewRound {
  id            String               @id @default(uuid())
  applicationId String
  application   Application          @relation(fields: [applicationId], references: [id])
  position      Int // display order (reorderable)
  type          InterviewRoundType   @default(TECHNICAL)
  typeOther     String? // used only when type = OTHER
  scheduledAt   DateTime? // optional date/time of the round
  result        InterviewRoundResult @default(PENDING)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([applicationId, position])
}

// In-app notifications (Phase 2 retention). A small, fixed set that pairs with
// the weekly digest. Denormalized `actorHandle` so rendering needs no join, and
// pseudonymous by construction (only a handle, never PII). `sinkId`/`commentId`
// are plain ids for linking (no FK — a soft-deleted target still resolves).
enum NotificationType {
  REPLY // someone commented on your Sink or replied to your comment
  BUOY // your Sink crossed a buoy milestone (10/25/50/100)
  POLL // your poll crossed a vote milestone
}

model Notification {
  id        String           @id @default(uuid())
  userId    String // recipient
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id])
  type      NotificationType
  // Who triggered it, stored as a REFERENCE (not a snapshot) so the CURRENT
  // handle is resolved at read time — handles are user-changeable, so a snapshot
  // would go stale. Null for cumulative BUOY/POLL (no single actor).
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id])
  count     Int? // milestone value for BUOY/POLL (e.g. 25 buoys); null for REPLY
  sinkId    String? // Sink to link to
  commentId String? // comment to anchor to (reply-to-comment)
  readAt    DateTime? // null = unread
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Feedback / "message the owner" — complaints and suggestions from anyone
// (signed in or not). Owner-only: never exposed in any public API. We store
// every submission so nothing is lost even if the notification email fails or
// isn't configured yet; the optional contactEmail is PII, so keep this private.
model Feedback {
  id           String   @id @default(uuid())
  message      String   @db.Text
  contactEmail String? // optional — if the sender wants a reply
  userId       String? // set if signed in (no FK — outlives users)
  handle       String? // sender's pseudonymous handle at submit time, if signed in
  path         String? // page they were on, for context
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
