# SinkedIn backend — TEST environment template (committed).
# Copy to `.env.test` (gitignored) and adjust if your local setup differs.
#
# KEY IDEA: tests run against a SEPARATE database (sinkedin_test), never the
# dev database, so a test can freely create/delete rows without harming dev
# data. Same Docker container, same host port (5434), different database name.

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/sinkedin_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/sinkedin_test?schema=public"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="test-anon-key"
SUPABASE_SERVICE_ROLE_KEY="test-service-role-key"

PORT="4001"
