# SinkedIn backend — environment variable template.
#
# HOW TO USE: copy this file to `.env` in the same folder and replace the
# placeholder values with real ones. `.env` is gitignored and must NEVER be
# committed; this `.env.example` is committed on purpose as documentation.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Database (Supabase Postgres, via Prisma)
# ---------------------------------------------------------------------------

# Pooled connection (PgBouncer). Used by the app at RUNTIME for normal queries.
# Note the `?pgbouncer=true` flag Supabase requires for the pooled URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (no pooler). Used ONLY by Prisma Migrate for schema changes.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-region.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------

# Your project URL, e.g. https://PROJECT_REF.supabase.co
# Used to build the JWKS endpoint for verifying asymmetric access tokens.
SUPABASE_URL="https://PROJECT_REF.supabase.co"

# JWT secret used to VERIFY user access tokens locally (no network call to
# Supabase on every request). Copy from Supabase dashboard →
# Settings → API → JWT Keys → Legacy JWT Secret. SERVER-SIDE ONLY — never
# expose or commit. (The anon + service-role keys are no longer needed by the
# backend since auth moved to local JWT verification.)
SUPABASE_JWT_SECRET="your-jwt-secret"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Local dev port. In production the host (Render) injects PORT automatically.
PORT="4000"

# Frontend origin allowed by CORS. Optional — defaults to http://localhost:5173.
FRONTEND_URL="http://localhost:5173"
