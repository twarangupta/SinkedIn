{
  /* Config for the APPLICATION code in src/ — this runs in the browser. */
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Vite handles the actual bundling, so TypeScript only type-checks and
       emits nothing (noEmit). This keeps type errors visible without TS and
       Vite both trying to produce output. */
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness — same philosophy as the backend. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": ["src"]
}
