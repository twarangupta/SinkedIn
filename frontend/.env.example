# SinkedIn frontend — environment template (committed).
# Copy to `.env` (gitignored) and fill with your Supabase project's PUBLIC
# values. Vite only exposes VITE_-prefixed vars to the browser.
#
# WHERE TO FIND THESE: Supabase dashboard → Settings → API.
#   - VITE_SUPABASE_URL      = Project URL (https://<ref>.supabase.co)
#   - VITE_SUPABASE_ANON_KEY = the anon / publishable key (safe for browsers)
#
# NEVER put the service_role key here — it is server-only (backend/.env).

VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Backend API base URL. Optional — defaults to http://localhost:4000 in dev.
VITE_API_URL="http://localhost:4000"
